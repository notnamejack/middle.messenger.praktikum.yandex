<main class="page" id="page">
    <div class="container-message">
        <div class="chats">
            <div class="profile">
                <button type="button" class="create-chat-btn" data-action="open-create-chat">
                    Создать чат
                </button>
                <a href="/settings" class="link" data-link>Профиль</a>
            </div>

            <div class="find">
                <input
                    ref="search"
                    name="search"
                    class="find-chat"
                    placeholder="Поиск"
                    autocomplete="off"
                />
            </div>

            <ul class="list">
                {{#if isSearching}}
                    {{#each searchResults}}
                        {{#if isNewChat}}
                            <li
                                class="item search-item"
                                data-search-type="new-chat"
                                data-title="{{title}}"
                            >
                                <div class="avatar empty"></div>
                                <div class="message">
                                    <p class="name">{{title}}</p>
                                    <p class="text-message search-item__hint">Новый чат</p>
                                </div>
                            </li>
                        {{/if}}

                        {{#if isChat}}
                            <li
                                class="item search-item{{#if active}} item--active{{/if}}"
                                data-search-type="chat"
                                data-id="{{id}}"
                                data-title="{{name}}"
                            >
                                <div class="avatar{{#unless avatarUrl}} empty{{/unless}}">
                                    {{#if avatarUrl}}
                                        <img src="{{avatarUrl}}" alt="" />
                                    {{/if}}
                                </div>
                                <div class="message">
                                    <p class="name">{{name}}</p>
                                    <p class="text-message">
                                        {{#if prefix}}<span>{{prefix}}</span>{{/if}}{{text}}
                                    </p>
                                </div>
                                <div class="metrika">
                                    <p class="time">{{time}}</p>
                                    {{#if count}}<p class="count">{{count}}</p>{{/if}}
                                </div>
                            </li>
                        {{/if}}

                        {{#if isUser}}
                            <li
                                class="item search-item"
                                data-search-type="user"
                                data-id="{{id}}"
                                data-name="{{name}}"
                                data-login="{{login}}"
                            >
                                <div class="avatar{{#unless avatarUrl}} empty{{/unless}}">
                                    {{#if avatarUrl}}
                                        <img src="{{avatarUrl}}" alt="" />
                                    {{/if}}
                                </div>
                                <div class="message">
                                    <p class="name">{{name}}</p>
                                    <p class="text-message search-item__hint">{{login}}</p>
                                </div>
                            </li>
                        {{/if}}
                    {{/each}}
                {{else}}
                    {{#each chats}}
                        {{{ ChatItem
                            id=id
                            name=name
                            text=text
                            time=time
                            count=count
                            prefix=prefix
                            active=active
                            avatarUrl=avatarUrl
                        }}}
                    {{else}}
                        <li class="item empty">
                            <p class="desc">У вас нет чатов</p>
                        </li>
                    {{/each}}
                {{/if}}
            </ul>
        </div>

        <div class="chat{{#unless activeChatId}} empty{{/unless}}">
            {{#unless activeChatId}}
                <p class="desc">Выберите чат чтобы отправить сообщение</p>
            {{/unless}}

            {{#if activeChatId}}
                <div class="chat-item">
                    <div class="header">
                        <div class="user">
                            <div class="avatar{{#unless activeChatAvatarUrl}} empty{{/unless}}">
                                {{#if activeChatAvatarUrl}}
                                    <img src="{{activeChatAvatarUrl}}" alt="" />
                                {{/if}}
                            </div>
                            <p class="name">{{activeChatTitle}}</p>
                        </div>

                        <div class="setting-wrap">
                            <button
                                type="button"
                                class="setting"
                                data-action="toggle-chat-menu"
                                aria-label="Меню чата"
                            >
                                <span></span>
                                <span></span>
                                <span></span>
                            </button>

                            {{#if chatMenuOpen}}
                                <div class="chat-menu">
                                    <button
                                        type="button"
                                        class="chat-menu__item"
                                        data-action="open-chat-avatar"
                                    >
                                        <span class="chat-menu__icon chat-menu__icon--avatar">
                                            <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path fill-rule="evenodd" clip-rule="evenodd" d="M4 1.5H18C19.3807 1.5 20.5 2.61929 20.5 4V14L14.5194 12.4052C13.5108 12.1362 12.4714 12 11.4275 12H10.5725C9.52864 12 8.48921 12.1362 7.48057 12.4052L1.5 14V4C1.5 2.61929 2.61929 1.5 4 1.5ZM0 4C0 1.79086 1.79086 0 4 0H18C20.2091 0 22 1.79086 22 4V18C22 20.2091 20.2091 22 18 22H4C1.79086 22 0 20.2091 0 18V4ZM8 6C8 7.10457 7.10457 8 6 8C4.89543 8 4 7.10457 4 6C4 4.89543 4.89543 4 6 4C7.10457 4 8 4.89543 8 6Z" fill="#3369F3"/>
                                            </svg>
                                        </span>
                                        Изменить фото чата
                                    </button>
                                    <button
                                        type="button"
                                        class="chat-menu__item"
                                        data-action="open-add-user"
                                    >
                                        <span class="chat-menu__icon chat-menu__icon--add"></span>
                                        Добавить пользователя
                                    </button>
                                    <button
                                        type="button"
                                        class="chat-menu__item"
                                        data-action="open-remove-user"
                                    >
                                        <span class="chat-menu__icon chat-menu__icon--remove"></span>
                                        Удалить пользователя
                                    </button>
                                </div>
                            {{/if}}
                        </div>
                    </div>

                    <div class="body">
                        <div class="datetime">
                            <p></p>
                        </div>

                        {{!-- sprint 4: WebSocket — лента сообщений
                        <div class="message-list">
                            <div class="message user">
                                <p class="text">...</p>
                                <p class="time">11:56</p>
                            </div>
                            <div class="message my">
                                <p class="text">Круто!</p>
                                <p class="time">12:00</p>
                            </div>
                        </div>
                        --}}
                    </div>

                    <div class="footer">
                        <input
                            ref="chatAvatar"
                            type="file"
                            name="chatAvatar"
                            accept="image/*"
                            class="chat-avatar-input"
                            hidden
                        />
                        <button type="button" class="btn-file"></button>
                        <input
                            type="text"
                            class="input-message"
                            placeholder="Сообщение"
                            name="message"
                        />
                        <button type="button" class="btn-send"></button>
                    </div>
                </div>
            {{/if}}
        </div>
    </div>

    {{#if isChatAvatarModalOpen}}
        <div class="chat-modal-overlay">
            <div class="chat-modal">
                <button type="button" class="modal-close" data-action="close-modal" aria-label="Закрыть"></button>

                {{#if isChatAvatarFileSelected}}
                    <p class="chat-modal__title">Файл загружен</p>
                    <p class="chat-modal__filename">{{selectedChatAvatarName}}</p>
                {{else}}
                    <p class="chat-modal__title">Загрузите файл</p>
                    <button type="button" class="chat-modal__link" data-action="pick-chat-avatar">
                        Выбрать файл на компьютере
                    </button>
                {{/if}}

                {{#if modalError}}
                    <p class="chat-modal__error">{{modalError}}</p>
                {{/if}}

                <button type="button" class="btn chat-modal__submit" data-action="upload-chat-avatar">
                    Поменять
                </button>
            </div>
        </div>
    {{/if}}

    {{#if isCreateChatModalOpen}}
        <div class="chat-modal-overlay">
            <div class="chat-modal">
                <button type="button" class="modal-close" data-action="close-modal" aria-label="Закрыть"></button>
                <p class="chat-modal__title">Новый чат</p>

                <label class="chat-modal__field">
                    <span class="chat-modal__label">Название</span>
                    <input
                        ref="modalChatTitle"
                        class="chat-modal__input"
                        type="text"
                        name="title"
                        autocomplete="off"
                    />
                </label>

                {{#if modalError}}
                    <p class="chat-modal__error">{{modalError}}</p>
                {{/if}}

                <button type="button" class="btn chat-modal__submit" data-action="submit-create-chat">
                    Создать
                </button>
            </div>
        </div>
    {{/if}}

    {{#if isAddUserModalOpen}}
        <div class="chat-modal-overlay">
            <div class="chat-modal">
                <button type="button" class="modal-close" data-action="close-modal" aria-label="Закрыть"></button>
                <p class="chat-modal__title">Добавить пользователя</p>

                <label class="chat-modal__field">
                    <span class="chat-modal__label">Логин</span>
                    <input
                        ref="modalLogin"
                        class="chat-modal__input"
                        type="text"
                        name="login"
                        autocomplete="off"
                    />
                </label>

                {{#if modalError}}
                    <p class="chat-modal__error">{{modalError}}</p>
                {{/if}}

                <button type="button" class="btn chat-modal__submit" data-action="submit-add-user">
                    Добавить
                </button>
            </div>
        </div>
    {{/if}}

    {{#if isRemoveUserModalOpen}}
        <div class="chat-modal-overlay">
            <div class="chat-modal">
                <button type="button" class="modal-close" data-action="close-modal" aria-label="Закрыть"></button>
                <p class="chat-modal__title">Удалить пользователя</p>

                <label class="chat-modal__field">
                    <span class="chat-modal__label">Логин</span>
                    <input
                        ref="modalLogin"
                        class="chat-modal__input"
                        type="text"
                        name="login"
                        autocomplete="off"
                    />
                </label>

                {{#if modalError}}
                    <p class="chat-modal__error">{{modalError}}</p>
                {{/if}}

                <button type="button" class="btn chat-modal__submit" data-action="submit-remove-user">
                    Удалить
                </button>
            </div>
        </div>
    {{/if}}
</main>
